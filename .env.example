# Copy this file to .env locally or configure these values in your host.
# Never commit a real SECRET_KEY, DATABASE_URL or payment-provider credentials.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=0
ALLOWED_HOSTS=your-domain.example,www.your-domain.example
# For Neon, paste the complete PostgreSQL connection string after DATABASE_URL=.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional local demo account. On Render, this account is created by build.sh.
DEMO_USERNAME=user
DEMO_PASSWORD=user12345
DEFAULT_FROM_EMAIL=noreply@your-domain.example
EMAIL_HOST=smtp.your-provider.example
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=1
